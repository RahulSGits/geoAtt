# New Supabase project. Copy to `.env` (gitignored) and fill in.
#
# Never commit real values. The publishable key is public by design — it ships
# in every client — but the service-role key bypasses ALL row level security
# and must never leave the server or enter this repository.

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only. Project Settings -> API keys -> service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Project Settings -> Database -> Connection string -> URI. Used to apply
# migrations with psql.
SUPABASE_DB_URL=

# Drives lateness in compute_attendance_status. Also set it on the database:
#   alter database postgres set app.timezone = 'Asia/Kolkata';
APP_TIMEZONE=Asia/Kolkata

# Password given to the accounts created by db/tools/create-accounts.mjs.
# 8+ characters. The script refuses to run without it rather than falling back
# to a default, because a default in a public repo is a working credential.
DEMO_PASSWORD=
