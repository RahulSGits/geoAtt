# Which origin the native shells load. This is the ONLY thing that differs
# between a dev build and a store build — copy this file to `mobile/.env`,
# set one value, then `npm run sync`.
#
# Production / TestFlight / store builds — must be https:
# FINATT_APP_URL=https://finatt.vercel.app
#
# LAN dev against `npm run dev` in frontend/ (which already binds 0.0.0.0).
# Use your Mac's LAN IP, not localhost — localhost inside a phone is the phone.
#   ipconfig getifaddr en0
# Camera check-in will NOT work over plain http: WebKit and Chromium both gate
# getUserMedia behind a secure context. Use this for UI work only, or run
# `cloudflared tunnel --url http://localhost:3000` for an https dev URL.
# FINATT_APP_URL=http://192.168.1.20:3000

FINATT_APP_URL=
