<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background plate. The generated foreground is a white mark on
  transparency, so this layer carries the colour — the Capacitor default was
  @color/ic_launcher_background (#FFFFFF), which rendered white on white.

  Angle 315 runs top-left to bottom-right, matching the gradient baked into the
  legacy PNG icons in tools/generate-icons.mjs. Keep the two in step.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="#3B82F6"
        android:endColor="#1D4ED8"
        android:type="linear" />
</shape>
