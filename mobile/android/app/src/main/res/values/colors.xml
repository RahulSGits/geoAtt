<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides the placeholder colours that ship in the capacitor-android library
  resources. `colorPrimaryDark` is the status bar behind the WebView, so it is
  the app shell's own background rather than a brand blue — otherwise the bar
  sits as a bright band above a dark page.
-->
<resources>
    <color name="colorPrimary">#2563EB</color>
    <color name="colorPrimaryDark">#0B1220</color>
    <color name="colorAccent">#3B82F6</color>
</resources>
