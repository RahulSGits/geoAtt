<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay. The manifest merger applies it to `assembleDebug`
  and nothing else, so release builds are untouched.

  Android 9 (API 28) blocks cleartext HTTP by default, and Capacitor 8 no longer
  emits `usesCleartextTraffic` for `server.cleartext` — so pointing
  FINATT_APP_URL at http://<lan-ip>:3000 fails with ERR_CLEARTEXT_NOT_PERMITTED
  and a blank WebView without this.

  Deliberately not in the main manifest: a blanket cleartext opt-in on a release
  build is a Play Console pre-launch warning, and production loads https anyway.

  Camera check-in still will not work over http — Chromium gates getUserMedia on
  a secure context regardless of this setting. Use an https tunnel to test it.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
