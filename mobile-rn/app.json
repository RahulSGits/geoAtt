{
  "expo": {
    "name": "geoAtt",
    "slug": "geoatt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "geoatt",
    "userInterfaceStyle": "light",
    "backgroundColor": "#0A1230",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.geoatt.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.geoatt.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#1D4ED8",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1230",
          "image": "./assets/splash-icon.png",
          "imageWidth": 136,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "//": "iOS terminates the app outright if it asks for location without a usage string, so this is not optional. Only when-in-use is requested: attendance is recorded while the employee is looking at the screen, and asking for background location would be a far larger permission than the feature needs — and a likely App Store rejection.",
          "locationWhenInUsePermission": "geoAtt records where you check in, so your attendance can be confirmed against your assigned work site. Location is read only at the moment you check in or out."
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
