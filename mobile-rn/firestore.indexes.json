{
  "//": "Composite indexes for the queries this data model implies. Firestore serves single-field queries automatically; anything that filters on one field and orders by another needs an entry here. Deploy with: firebase deploy --only firestore:indexes",
  "indexes": [
    {
      "//": "An employee's own attendance history, newest first.",
      "collectionGroup": "attendance",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "date", "order": "DESCENDING" }
      ]
    },
    {
      "//": "HR's company-wide view of one day, filtered by status.",
      "collectionGroup": "attendance",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "date", "order": "ASCENDING" },
        { "fieldPath": "status", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Pending re-check-in requests awaiting an HR decision.",
      "collectionGroup": "attendance",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "recheckin_status", "order": "ASCENDING" },
        { "fieldPath": "recheckin_requested_at", "order": "DESCENDING" }
      ]
    },
    {
      "//": "An employee's own leave requests, newest first.",
      "collectionGroup": "leaves",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "//": "HR's approval queue: pending first, oldest first.",
      "collectionGroup": "leaves",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "start_date", "order": "ASCENDING" }
      ]
    },
    {
      "//": "One person's notification bell, unread state included.",
      "collectionGroup": "notifications",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "recipient_id", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Active roster by department, for the HR directory.",
      "collectionGroup": "employees",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "status", "order": "ASCENDING" },
        { "fieldPath": "department", "order": "ASCENDING" }
      ]
    },
    {
      "//": "Reward ledger for one employee.",
      "collectionGroup": "reward_events",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "employee_id", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    },
    {
      "//": "Announcement feed, high priority surfaced first.",
      "collectionGroup": "announcements",
      "queryScope": "COLLECTION",
      "fields": [
        { "fieldPath": "priority", "order": "ASCENDING" },
        { "fieldPath": "created_at", "order": "DESCENDING" }
      ]
    }
  ],
  "fieldOverrides": []
}
