# Copy to .env.local and fill in. .env.local is gitignored; this file is not,
# so never put a real key here.
#
# Both Supabase values come from Project Settings -> API keys.

# ---------------------------------------------------------------------------
# Required. Without these the app builds but every request fails.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable / anon key>

# ---------------------------------------------------------------------------
# Required for creating logins, inviting members, reset links and deleting the
# auth user behind a removed employee. Without it those actions fail with a
# clear message and everything else still works.
#
# SECRET. Never prefix it with NEXT_PUBLIC_ — that would ship it to the browser.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=<secret / service_role key>

# The absolute origin used to build links inside emails. Must match the
# deployment: a stale value here sends invitees to the wrong host, and the link
# still looks valid. On Vercel set this to your production URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional but strongly recommended: the owner account(s).
#
# Comma separated. An account listed here cannot have its portal changed, its
# password reset, or be deleted — by anyone, including another administrator.
# The owner can still change their own password from My Profile.
#
# This is what stops a second admin, or a mistake, from locking you out of your
# own deployment. Server-only: never prefix it with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------
PROTECTED_ACCOUNTS=you@company.com

# ---------------------------------------------------------------------------
# Optional. Email for invites, leave decisions and password resets.
# EMAIL_FROM must be quoted — the angle brackets are shell redirects otherwise.
#
# Resend's sandbox sender onboarding@resend.dev only delivers to your own Resend
# account address. Mail to anyone else is accepted and silently dropped, so
# verify a domain before onboarding real staff.
# ---------------------------------------------------------------------------
RESEND_API_KEY=<resend key>
EMAIL_FROM="FinAtt <noreply@yourdomain.com>"

# ---------------------------------------------------------------------------
# Optional. The AI assistant, and the Google Maps provider for the site editor.
# Without GEMINI_API_KEY the assistant is disabled; without the Maps key the
# site editor falls back to Leaflet/OpenStreetMap.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=<key>
GEMINI_MODEL=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<key>

# ---------------------------------------------------------------------------
# Optional. Lets scripts/fix-all.sh apply migrations over the Management API.
# A personal access token from supabase.com/dashboard/account/tokens.
# ---------------------------------------------------------------------------
SUPABASE_ACCESS_TOKEN=<sbp_...>

# Password new HR and employee accounts start on. Must be at least 8 chars.
# Creating logins is refused when unset, rather than falling back to a weak
# shared default. Rotate it here; no code change needed.
ONBOARDING_PASSWORD=
